# Development only. Copy to .env; never commit real credentials.
POSTGRES_DB=backroom
POSTGRES_USER=backroom
POSTGRES_PASSWORD=backroom_local_only
POSTGRES_PORT=5432
SERVER_PORT=8080
# Address encoded in printed QR labels. For phone testing use the HTTPS dev address, e.g. https://192.168.1.20:5173
BACKROOM_PUBLIC_URL=http://localhost:5173
# Optional: when the API connects to a database other than local Compose.
# DATABASE_URL=jdbc:postgresql://localhost:5432/backroom
# DATABASE_USERNAME=backroom
# DATABASE_PASSWORD=replace-me

# ---- Production (set these in the hosting platform, not in a committed file; see docs/operations.md) ----
# SPRING_PROFILES_ACTIVE=prod                 # Secure cookies, forwarded headers, JSON logs, probes
# BACKROOM_PUBLIC_URL=https://stock.example.com   # Required in prod: permanent HTTPS address printed on labels
# DATABASE_URL=jdbc:postgresql://db-host:5432/backroom?sslmode=require
# DATABASE_USERNAME=backroom
# DATABASE_PASSWORD=from-the-platform-secret-store
# SERVER_PORT=8080                            # Set to the platform's port variable if it assigns one
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50   # Half of a 512 MB container for the heap
